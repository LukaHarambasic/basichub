services:
  homeassistant:
    image: ghcr.io/home-assistant/home-assistant:stable
    container_name: homeassistant
    restart: always
    volumes:
      - /home/{{ ansible_user }}/homeassistant:/config
    devices:
      - "{{ zigbee_device }}:/dev/ttyUSB0"
    environment:
      TZ: "{{ ansible_facts['timezone'] | default('UTC') }}"
    ports:
      - "8123:8123"

networks:
  traefik_net:
    external: true
